{
  "name": "idiolect",
  "productName": "Idiolect",
  "version": "0.2.0",
  "description": "Glosario de las expresiones de Fran, exportado como glosario.md para Claude Code.",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems <umbrovex@proton.me>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/glosario.test.mjs && node test/actualizador.test.mjs",
    "smoke": "electron test/renderer.test.cjs",
    "icon": "python tools/icon.py",
    "build": "electron-builder --win --publish never",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8"
  },
  "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
  "build": {
    "appId": "com.umbrovex.idiolect",
    "productName": "Idiolect",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!tools/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kiddshady",
        "repo": "Idiolect",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/kiddshady/Idiolect",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Idiolect.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
